# SentinelX environment template — copy to .env (git-ignored) and fill in.
# Every setting in config.py can be overridden as SENTINELX_<NAME>.

# Required in production: long random string, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`
SENTINELX_SECRET_KEY=
SENTINELX_ENV=development            # development | production

# Network binding (default is loopback only)
SENTINELX_FLASK_HOST=127.0.0.1
SENTINELX_FLASK_PORT=5001
# Set to 1 only behind a trusted reverse proxy that sets X-Forwarded-For
SENTINELX_TRUST_PROXY=0
# Send session cookies only over HTTPS (defaults to on when ENV=production)
SENTINELX_SESSION_COOKIE_SECURE=

# Model: "auto" = registry default (fine-tuned if present), or an id from models/registry.yaml
SENTINELX_MODEL_ID=auto
SENTINELX_YOLO_DEVICE=               # "", cpu, mps, 0
SENTINELX_INFER_FPS=10

# Storage (relative paths are resolved against the repository root)
SENTINELX_DB_PATH=instance/sentinelx.db
SENTINELX_EVIDENCE_DIR=instance/evidence
SENTINELX_BACKUP_DIR=instance/backups
SENTINELX_EVIDENCE_RETENTION_DAYS=30

# Alerts
SENTINELX_ALERT_MIN_SEVERITY=HIGH
SENTINELX_ALERT_COOLDOWN_SECONDS=60
SENTINELX_ALERT_WEBHOOK_URL=         # optional HTTPS endpoint receiving alert JSON

# Network camera URLs (referenced by name from config/cameras.yaml `url_env`)
# SENTINELX_CAM03_URL=rtsp://user:password@camera-host:554/stream1

# Development only — refused when SENTINELX_ENV=production
SENTINELX_AUTH_DISABLED=0
