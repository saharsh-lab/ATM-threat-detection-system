{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "{data/**,datasets/**,runs/**,instance/**,models/**,ml/**,tests/**,db/**,core/**,web/**,utils/**,reports/**,docs/**,venv/**,venv_mac/**,ATM-Threat-Detection-System/**,content-recommendation-engine/**,*.pt,export_timeline.py,manage.py,app.py}"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
